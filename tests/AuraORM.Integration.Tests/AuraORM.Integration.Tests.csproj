<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same statements run on each supported database (docs/design.ja.md §17). SQLite runs in process; the other
       databases come from environment variables, set by CI's service containers or tools/ locally (row I1). -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>AuraORM.Integration.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AuraORM\AuraORM.csproj" />
    <ProjectReference Include="..\..\src\AuraORM.Generators\AuraORM.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- -p:AuraSqliteMinimum=true runs SQLite on its minimum version, 3.39.2 (docs/design.ja.md §17, CI's sqlite job): the
       native library of SQLitePCLRaw.lib.e_sqlite3 2.1.3 instead of the one Microsoft.Data.Sqlite bundles. -->
  <PropertyGroup Condition="'$(AuraSqliteMinimum)' == 'true'">
    <DefineConstants>$(DefineConstants);AURA_SQLITE_MINIMUM</DefineConstants>
    <!-- The 2.1.3 package has native libraries for alpine runtime identifiers, which .NET 8 and later do not look up. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(AuraSqliteMinimum)' == 'true'">
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <!-- CVE-2025-6965 in SQLite before 3.50.2. The tests use in-memory databases of their own data, and nothing of this
         build ships (docs/design.ja.md §17). -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
  <ItemGroup Condition="'$(AuraSqliteMinimum)' != 'true'">
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>
</Project>
