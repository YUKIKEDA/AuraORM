<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The tests run on the oldest supported runtime and the newest (.cursor/rules/testing.mdc). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>AuraORM.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AuraORM\AuraORM.csproj" />
    <!-- The generator runs on the test tables, as it does in a consumer's project. -->
    <ProjectReference Include="..\..\src\AuraORM.Generators\AuraORM.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
