<Project Sdk="Microsoft.NET.Sdk">
  <!-- The NativeAOT check (docs/design.ja.md §16.3, .cursor/rules/aot.mdc): CI publishes this app with NativeAOT and runs it,
       for net8.0 and net10.0, since a newer ILC can warn where an older one does not. It uses the public API that a consumer
       uses. CI references the packed package (AuraPackageVersion, row R1), so the generator runs from the package as it
       does for a consumer; without the property, it references the projects, for development. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(AuraPackageVersion)' == ''">
    <ProjectReference Include="..\..\src\AuraORM\AuraORM.csproj" />
    <ProjectReference Include="..\..\src\AuraORM.Generators\AuraORM.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(AuraPackageVersion)' != ''">
    <PackageReference Include="AuraORM" VersionOverride="$(AuraPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
</Project>
