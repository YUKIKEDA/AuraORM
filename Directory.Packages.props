<Project>
  <!-- Central Package Management. A new dependency is checked against .cursor/rules/dependencies.mdc first. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Analyzers">
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.82-beta" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Roslyn">
    <!-- 4.8 is the compiler of the first .NET 8 SDK; the generator and the compile tests use it (docs/design.ja.md §2.1). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup Label="Providers">
    <!-- ADO.NET providers for the integration tests and samples only; the library depends on none (.cursor/rules/dependencies.mdc). -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Pinned above the versions that Microsoft.Data.SqlClient brings, which have known vulnerabilities
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7; patched in 10.0.13). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <!-- SQLite 3.39.2, the minimum version (docs/design.ja.md §1.3, §17), for the integration tests built with
       -p:AuraSqliteMinimum=true only. Declared only for that build, because transitive pinning would hold every other
       project that uses Microsoft.Data.Sqlite to the old native library. The provider matches the SQLitePCLRaw.core that
       Microsoft.Data.Sqlite.Core brings; the provider of 2.1.3 does not load with it. -->
  <ItemGroup Label="SQLite minimum" Condition="'$(AuraSqliteMinimum)' == 'true'">
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.13" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.3" />
  </ItemGroup>
</Project>
