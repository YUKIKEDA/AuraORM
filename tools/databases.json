{
  "$comment": "The databases of the integration tests. CI (.github/workflows/ci.yml) and tools/db.ps1 both read this file, so local runs and the merge gate use the same images (.cursor/rules/containers.mdc). Each database is tested at its minimum supported version and its latest one (docs/design.ja.md §1.3, §17).",
  "databases": [
    {
      "name": "postgresql",
      "image": "postgres",
      "versions": ["15", "18"],
      "port": 5432,
      "localPort": 55432,
      "environment": { "POSTGRES_PASSWORD": "Aura_Test_1", "POSTGRES_DB": "aura" },
      "health": ["pg_isready", "-U", "postgres"],
      "connectionString": "Host=localhost;Port={port};Username=postgres;Password=Aura_Test_1;Database=aura"
    },
    {
      "name": "mysql",
      "image": "mysql",
      "versions": ["8.4", "9"],
      "port": 3306,
      "localPort": 53306,
      "environment": { "MYSQL_ROOT_PASSWORD": "Aura_Test_1", "MYSQL_DATABASE": "aura" },
      "health": ["mysqladmin", "ping", "-h", "127.0.0.1", "-uroot", "-pAura_Test_1"],
      "connectionString": "Server=127.0.0.1;Port={port};User ID=root;Password=Aura_Test_1;Database=aura;AllowPublicKeyRetrieval=True"
    },
    {
      "name": "mariadb",
      "image": "mariadb",
      "versions": ["10.11", "12"],
      "port": 3306,
      "localPort": 53307,
      "environment": { "MARIADB_ROOT_PASSWORD": "Aura_Test_1", "MARIADB_DATABASE": "aura" },
      "health": ["healthcheck.sh", "--connect", "--innodb_initialized"],
      "connectionString": "Server=127.0.0.1;Port={port};User ID=root;Password=Aura_Test_1;Database=aura"
    },
    {
      "name": "sqlserver",
      "image": "mcr.microsoft.com/mssql/server",
      "versions": ["2019-latest", "2025-latest"],
      "port": 1433,
      "localPort": 51433,
      "environment": { "ACCEPT_EULA": "Y", "MSSQL_SA_PASSWORD": "Aura_Test_1" },
      "health": ["bash", "-c", "/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P Aura_Test_1 -Q 'SELECT 1' || /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P Aura_Test_1 -Q 'SELECT 1'"],
      "connectionString": "Server=127.0.0.1,{port};User ID=sa;Password=Aura_Test_1;TrustServerCertificate=True;Database=master"
    }
  ]
}
