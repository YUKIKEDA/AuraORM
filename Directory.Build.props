<Project>
  <!-- Shared settings for every project. Conventions: docs/conventions.md. Dependency rules: .cursor/rules/dependencies.mdc. -->
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- Warnings are errors from the first commit. Trim and AOT warnings must be zero (.cursor/rules/aot.mdc). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Features>strict</Features>

    <!-- Deterministic builds; CI paths are normalized for Source Link. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <IsPackable>false</IsPackable>

    <_AuraRelativeDir>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))</_AuraRelativeDir>
    <AuraIsSrcProject>false</AuraIsSrcProject>
    <AuraIsSrcProject Condition="$(_AuraRelativeDir.StartsWith('src/'))">true</AuraIsSrcProject>
    <AuraIsTestProject>false</AuraIsTestProject>
    <AuraIsTestProject Condition="$(_AuraRelativeDir.StartsWith('tests/'))">true</AuraIsTestProject>
  </PropertyGroup>

  <!-- The libraries under src/ ship in the AuraORM package. The runtime library must be AOT compatible. -->
  <PropertyGroup Condition="'$(AuraIsSrcProject)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>YUKIKEDA</Authors>
    <Copyright>Copyright (c) 2026 YUKIKEDA and contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/YUKIKEDA/AuraORM</PackageProjectUrl>
    <RepositoryUrl>https://github.com/YUKIKEDA/AuraORM.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(AuraIsTestProject)' == 'true'">
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference
      Include="StyleCop.Analyzers"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
    />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <!-- Banned APIs for the runtime library (.cursor/rules/aot.mdc). The source generator runs inside the compiler and is exempt. -->
  <ItemGroup Condition="'$(AuraIsSrcProject)' == 'true' And '$(MSBuildProjectName)' != 'AuraORM.Generators'">
    <PackageReference
      Include="Microsoft.CodeAnalysis.BannedApiAnalyzers"
      PrivateAssets="all"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
    />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>
</Project>
